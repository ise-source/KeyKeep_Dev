<Window x:Class="LogParser.Engine.GrandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LogParser.Engine"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen"
        xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="700" Width="1200" FontFamily="Bahnschrift Condensed" Closing="Window_Closing"
        ResizeMode="NoResize" Background="#161616" WindowStyle="None">

    <Grid UseLayoutRounding="True">
        <MD:Transitioner SelectedIndex="0" Name="MainContainer">
            <!-- НАЧАЛО 1 ЭКРАНА -->
            <MD:TransitionerSlide>
                <MD:TransitionerSlide.Background>
                    <LinearGradientBrush>
                        <GradientStop Color="#202124" Offset="0"/>
                        <GradientStop Color="#1c1d1f" Offset="2"/>
                    </LinearGradientBrush>
                </MD:TransitionerSlide.Background>

                <Grid>
                    <MD:TransitioningContent Margin="20" HorizontalAlignment="Center" VerticalAlignment="Top">
                        <MD:TransitioningContent.OpeningEffects>
                            <MD:TransitionEffect Kind="SlideInFromTop" Duration="0:0:2.5"/>
                            <MD:TransitionEffect Kind="ExpandIn" Duration="0:0:1.5"/>
                        </MD:TransitioningContent.OpeningEffects>

                        <TextBlock Text="{Binding Path=Current_Version, StringFormat={}VERSION {0}}" Foreground="White" FontSize="16" FontFamily="Bahnschrift SemiBold Condensed"/>
                    </MD:TransitioningContent>

                    <MD:TransitioningContent Margin="20" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <MD:TransitioningContent.OpeningEffects>
                            <MD:TransitionEffect Kind="SlideInFromBottom" Duration="0:0:2.5"/>
                            <MD:TransitionEffect Kind="ExpandIn" Duration="0:0:1.5"/>
                        </MD:TransitioningContent.OpeningEffects>

                        <TextBlock Foreground="White" Text="POWERED BY ISE" FontSize="16" FontFamily="Bahnschrift SemiBold Condensed"/>
                    </MD:TransitioningContent>

                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <MD:TransitioningContent>
                            <MD:TransitioningContent.OpeningEffects>
                                <MD:TransitionEffect Kind="FadeIn" Duration="0:0:1.5"/>
                                <MD:TransitionEffect Kind="ExpandIn" Duration="0:0:1.5"/>
                            </MD:TransitioningContent.OpeningEffects>

                            <TextBlock Margin="20" Text="KEY KEEP" Foreground="White" FontSize="44" FontFamily="Arial Black"/>
                        </MD:TransitioningContent>

                        <MD:TransitioningContent>
                            <MD:TransitioningContent.OpeningEffects>
                                <MD:TransitionEffect Kind="FadeIn" Duration="0:0:10"/>
                                <MD:TransitionEffect Kind="SlideInFromBottom" Duration="0:0:2.5"/>
                            </MD:TransitioningContent.OpeningEffects>

                            <ProgressBar Margin="20" Width="40" Height="40" Style="{StaticResource MaterialDesignCircularProgressBar}"
                                         IsIndeterminate="True">
                                <ProgressBar.Foreground>
                                    <LinearGradientBrush>
                                        <GradientStop Color="#190B8F58" Offset="0"/>
                                        <GradientStop Color="#0b8f58" Offset="1"/>
                                    </LinearGradientBrush>
                                </ProgressBar.Foreground>
                            </ProgressBar>
                        </MD:TransitioningContent>
                    </StackPanel>
                </Grid>
            </MD:TransitionerSlide>
            <!-- КОНЕЦ 1 ЭКРАНА -->

            <!-- НАЧАЛО 2 ЭКРАНА -->
            <MD:TransitionerSlide>
                <MD:TransitionerSlide.OpeningEffects>
                    <MD:TransitionEffect Kind="SlideInFromLeft" Duration="0:0:0.5"/>
                    <MD:TransitionEffect Kind="FadeIn" Duration="0:0:1.5"/>
                </MD:TransitionerSlide.OpeningEffects>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>

                    <Border Margin="10" CornerRadius="20" Background="#202124">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" >
                                <Label Foreground="White" Content="KK"
                                       FontSize="18" FontFamily="Arial Black"/>
                            </StackPanel>

                            <ItemsControl>
                                <MD:TransitioningContent OpeningEffectsOffset="{MD:IndexedItemOffsetMultiplier 0:0:0.15}">
                                    <MD:TransitioningContent.OpeningEffects>
                                        <MD:TransitionEffect Kind="SlideInFromLeft" />
                                    </MD:TransitioningContent.OpeningEffects>

                                    <StackPanel VerticalAlignment="Center" Margin="0 20">
                                        <Border ToolTip="Все аккаунты" Name="BTN_Accounts" MouseEnter="BTN_MouseEnter" MouseLeave="BTN_MouseLeave" MouseDown="BTN_Accounts_MouseDown" Cursor="Hand" BorderThickness="3 0 0 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                BorderBrush="Transparent" Padding="5" Background="Transparent" Height="50">
                                            <MD:PackIcon Foreground="White" Kind="PasswordOutline"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Width="24" Height="24" />
                                        </Border>
                                    </StackPanel>
                                </MD:TransitioningContent>

                                <MD:TransitioningContent OpeningEffectsOffset="{MD:IndexedItemOffsetMultiplier 0:0:0.15}">
                                    <MD:TransitioningContent.OpeningEffects>
                                        <MD:TransitionEffect Kind="SlideInFromLeft" />
                                    </MD:TransitioningContent.OpeningEffects>

                                    <StackPanel VerticalAlignment="Center">
                                        <Border ToolTip="Настройки" MouseEnter="BTN_MouseEnter" MouseLeave="BTN_MouseLeave" Name="BTN_Settings" Cursor="Hand" BorderThickness="2 0 0 0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
                                                BorderBrush="Transparent" Background="Transparent" Padding="5" Height="50">
                                            <MD:PackIcon Foreground="White" Kind="Settings"
                                                         VerticalAlignment="Center" HorizontalAlignment="Center"
                                                         Width="24" Height="24" />
                                        </Border>
                                    </StackPanel>
                                </MD:TransitioningContent>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Frame Grid.Column="1" Name="MainFrame" NavigationUIVisibility="Hidden"/>
                </Grid>

            </MD:TransitionerSlide>
            <!-- КОНЕЦ 2 ЭКРАНА -->
        </MD:Transitioner>

        <MD:DialogHost Identifier="DialogControl" Name="M_DialogControl" OverlayBackground="#161616" Background="Transparent" CornerRadius="40" Panel.ZIndex="700" />

        <ItemsControl Name="NotifyContainer" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Panel.ZIndex="900" Margin="20">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <MD:Snackbar Margin="0 5" IsActive="{Binding IsActive}">
                        <MD:SnackbarMessage>
                            <StackPanel Orientation="Horizontal">
                                <MD:PackIcon VerticalAlignment="Center" Width="24" Height="24" Kind="{Binding Icon}"/>
                                <TextBlock MaxWidth="200" Margin="15 0" VerticalAlignment="Center" Foreground="White" Text="{Binding Message}" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </MD:SnackbarMessage>
                    </MD:Snackbar>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Name="MovePanel" VerticalAlignment="Top" Background="Transparent"  Panel.ZIndex="1000"
                MouseLeftButtonDown="BTN_MoveWindow_Down_Click" MouseMove="BTN_MoveWindow_MouseMove" MouseLeftButtonUp="BTN_MoveWindow_Up_Click" >
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Orientation="Horizontal">
                <TextBlock Text="{Binding Path=Current_Version, StringFormat={}v{0}}" Foreground="#66808080" FontSize="18" Margin="10 0" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <Border Name="BTN_CloseWindow" Style="{StaticResource ButtonCloseHoverStyle}" MouseDown="BTN_CloseWindow_MouseDown" Cursor="Hand" Width="50" Height="30" >
                    <MD:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="Close" Foreground="LightGray"/>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
