<Page x:Class="LogParser.Engine.Pages.AccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:LogParser.Engine.Pages"
      xmlns:MD="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" FontFamily="Bahnschrift Condensed" 
      d:DesignHeight="700" d:DesignWidth="1000"  Background="Transparent">

    <Page.Resources>
    </Page.Resources>
    
    <Grid UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="12*"/>
        </Grid.RowDefinitions>

        <Border Name="BTN_AddData" Panel.ZIndex="200" Style="{StaticResource ButtonAddControlHoverStyle}" HorizontalAlignment="Right" MouseDown="BTN_AddData_MouseDown" 
                Margin="10" Width="100" Height="35" Background="#BF2AC384" CornerRadius="15" Cursor="Hand">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <MD:PackIcon Foreground="White" Width="16" Height="16" VerticalAlignment="Center" Kind="Add"/>
                <TextBlock Foreground="White" Margin="2 0" VerticalAlignment="Center" Text="Добавить"/>
            </StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Center" Margin="10 20">
            <TextBlock Text="Сохраненные аккаунты" Foreground="White" VerticalAlignment="Center" FontSize="30" FontFamily="Bahnschrift SemiBold Condensed"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Name="LB_Count" Text="{Binding Path=Count, StringFormat={}{0} всего}" Foreground="White" VerticalAlignment="Center" FontSize="18" FontFamily="Bahnschrift SemiBold Condensed"/>
                <Label Content="(найдено в Базе Данных)" Foreground="LightGray" VerticalAlignment="Center" FontSize="18" FontFamily="Bahnschrift Light Condensed"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="5*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="15*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <TextBox Name="TB_Search" Grid.Row="0" Margin="10 5" Background="#202124" VerticalContentAlignment="Center"
                         MD:TextFieldAssist.HasLeadingIcon="True" Padding="10 0" MD:TextFieldAssist.LeadingIcon="Search"
                         BorderBrush="Transparent" BorderThickness="1" MD:HintAssist.Hint="Поиск" FontSize="16" Foreground="White"
                         MD:TextFieldAssist.UnderlineBrush="Transparent" MD:TextFieldAssist.TextFieldCornerRadius="15" TextChanged="TB_Search_TextChanged"/>

                <Border Grid.Row="1" Margin="10 5" Background="#202124" CornerRadius="15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Name="BTN_AllAccounts" MouseDown="BTN_SwitchFilter_MouseDown" HorizontalAlignment="Stretch" Cursor="Hand" Margin="30 5" Background="Transparent" CornerRadius="15" VerticalAlignment="Stretch">
                            <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Все"/>
                        </Border>

                        <Border Name="BTN_FavoritAccounts" MouseDown="BTN_SwitchFilter_MouseDown" Grid.Column="1" Cursor="Hand" HorizontalAlignment="Stretch" Margin="30 5" CornerRadius="15" Background="Transparent" VerticalAlignment="Stretch">
                            <TextBlock FontSize="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Text="Избранные"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="10 5" Background="#202124" CornerRadius="15">
                </Border>
                
                <Border Grid.Row="3" Margin="10 5" Background="#202124" CornerRadius="15">
                    <ListView Name="IC_View" SelectionMode="Single" Margin="10" BorderBrush="Transparent" 
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="IC_View_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignCardsListBoxItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <MD:TransitioningContent OpeningEffectsOffset="{MD:IndexedItemOffsetMultiplier 0:0:0.05}" >
                                                <MD:TransitioningContent.OpeningEffects>
                                                    <MD:TransitionEffect Kind="ExpandIn" />
                                                </MD:TransitioningContent.OpeningEffects>

                                                <Border Name="Border" HorizontalAlignment="Stretch" Style="{StaticResource ItemHoverStyle}" VerticalAlignment="Stretch" Cursor="Hand"
                                                        Margin="1" Padding="5" Background="#33808080" CornerRadius="20">
                                                    <ContentPresenter />
                                                </Border>
                                            </MD:TransitioningContent>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="true">
                                                    <Setter TargetName="Border" Property="Background" >
                                                        <Setter.Value>
                                                            <LinearGradientBrush>
                                                                <GradientStop Color="#145f40" Offset="0"/>
                                                                <GradientStop Color="#202c22" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="5*"/>
                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border HorizontalAlignment="Center" Width="32" Height="32"  VerticalAlignment="Center" Margin="10">
                                        <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Source" Value="{Binding Icon}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Data.Icon}" Value="{x:Null}">
                                                            <Setter Property="Source" Value="/Resources/noPhoto.png"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                    </Border>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Data.Name}" Foreground="White" FontSize="18" />
                                        <TextBlock Text="{Binding Data.Login}" Foreground="White" FontSize="16" FontFamily="Bahnschrift Light Condensed"/>
                                    </StackPanel>

                                    <Border MouseDown="BTN_EditFavorit_MouseDown" Grid.Column="2" Style="{StaticResource FavoritBorderStyle}">
                                        <MD:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <MD:PackIcon.Style>
                                                <Style TargetType="MD:PackIcon">
                                                    <Setter Property="Kind" Value="FavoriteBorder"/>
                                                    <Setter Property="ToolTip" Value="Добавить в избранное"/>
                                                    <Setter Property="Foreground" Value="White"/>

                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Kind" Value="Favorite"/>
                                                            <Setter Property="ToolTip" Value="Удалить в избранного"/>
                                                            <Setter Property="Foreground" Value="#0b8f58"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </MD:PackIcon.Style>
                                        </MD:PackIcon>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>

                        <ListView.Style>
                            <Style TargetType="ListView" BasedOn="{StaticResource MaterialDesignListView}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count, RelativeSource={RelativeSource Self}}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Content="Кажется, здесь ничего не нашлось." FontSize="24"/>
                                                        <Label HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="LightGray"
                                                               Content="Может быть, попробуете добавить что-то новенькое?" 
                                                               FontSize="14" FontFamily="Bahnschrift Light Condensed"/>
                                                    </StackPanel>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                    </ListView>
                </Border>

                <Border Grid.Row="4" Margin="10 5" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#202124" CornerRadius="15">
                    <ItemsControl Name="IC_Buttons" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.Resources>
                            <Style TargetType="Label">
                                <Setter Property="FontSize" Value="16"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Margin" Value="5"/>
                            </Style>
                        </ItemsControl.Resources>
                    </ItemsControl>
                </Border>
            </Grid>

            <MD:TransitioningContent Grid.Column="1" Name="MainPanel">
                <MD:TransitioningContent.Style>
                    <Style TargetType="MD:TransitioningContent">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Data}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MD:TransitioningContent.Style>
                
                <MD:TransitioningContent.OpeningEffects>
                    <MD:TransitionEffect Kind="FadeIn" Duration="0:0:0.5"/>
                    <MD:TransitionEffect Kind="SlideInFromTop" Duration="0:0:0.5"/>
                </MD:TransitioningContent.OpeningEffects>
                
                <StackPanel>
                    <Label Margin="10 0" Content="Общая информация" Foreground="LightGray" FontSize="20"/>
                    <Border Margin="10 5" Background="#202124" Padding="10" CornerRadius="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="5*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border HorizontalAlignment="Center" Width="48" Height="48"  VerticalAlignment="Center" Margin="10">
                                <Image HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Source" Value="{Binding Icon}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.Icon}" Value="{x:Null}">
                                                    <Setter Property="Source" Value="/Resources/noPhoto.png"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Data.Name}" Foreground="White" FontSize="20" />
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Data.WebSite}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                        
                                    <TextBlock Text="{Binding Data.WebSite}" Foreground="White" FontSize="18" FontFamily="Bahnschrift Light Condensed"/>
                                    <Border Margin="5 0" Cursor="Hand" Background="Transparent" MouseDown="BTN_OpenWebSite_MouseDown">
                                        <MD:PackIcon Kind="OpenInNew" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border Width="20" Height="20" MouseDown="BTN_EditFavorit_MouseDown" Style="{StaticResource FavoritBorderStyle}" Margin="10">
                                    <MD:PackIcon Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <MD:PackIcon.Style>
                                            <Style TargetType="MD:PackIcon">
                                                <Setter Property="ToolTip" Value="Добавить в избранное"/>
                                                <Setter Property="Kind" Value="FavoriteBorder"/>
                                                <Setter Property="Foreground" Value="White"/>

                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                        <Setter Property="ToolTip" Value="Удалить из избранного"/>
                                                        <Setter Property="Kind" Value="Favorite"/>
                                                        <Setter Property="Foreground" Value="#0b8f58"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </MD:PackIcon.Style>
                                    </MD:PackIcon>
                                </Border>

                                <Border ToolTip="Изменить данные" MouseDown="BTN_EditAccount_MouseDown" Width="20" Height="20" Style="{StaticResource ButtonWhiteHoverStyle}" Margin="10">
                                    <MD:PackIcon Width="20" Height="20" Foreground="White" Kind="Edit" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Label Margin="10 5" Content="Сохраненные данные" Foreground="LightGray" FontSize="20"/>
                    <Border Margin="10 5" Background="#202124" Padding="10" CornerRadius="15">
                        <StackPanel>
                            <StackPanel>
                                <TextBlock Text="Логин" Margin="10 0" Foreground="Gray" FontSize="16"/>

                                <Grid Margin="10 5">
                                    <TextBlock FontSize="20" VerticalAlignment="Center" Text="{Binding Data.Login}" Foreground="White"/>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border ToolTip="Скопировать логин" MouseDown="BTN_CopyLogin_MouseDown" Width="20" Height="20" Style="{StaticResource ButtonWhiteHoverStyle}" Margin="10">
                                            <MD:PackIcon Width="20" Height="20" Foreground="LightGray" Kind="ContentCopy" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border BorderBrush="#7F161616" Margin="0 10" CornerRadius="1" BorderThickness="0 2 0 0"/>

                            <StackPanel>
                                <TextBlock Text="Пароль" Margin="10 0" Foreground="Gray" FontSize="16"/>
                                <Grid Margin="10 5">
                                    <TextBlock FontSize="20" VerticalAlignment="Center" Text="{Binding Password}" Foreground="White">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHide}" Value="True">
                                                        <Setter Property="FontFamily" Value="Arial Black"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <Border Width="20" Height="20" MouseDown="BTN_HidePassword_MouseDown" Style="{StaticResource ButtonWhiteHoverStyle}" Margin="10">
                                            <MD:PackIcon Width="20" Height="20" Foreground="LightGray" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <MD:PackIcon.Style>
                                                    <Style TargetType="MD:PackIcon">
                                                        <Setter Property="Kind" Value="EyeOff"/>
                                                        <Setter Property="ToolTip" Value="Скрыть пароль"/>

                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsHide}" Value="True">
                                                                <Setter Property="Kind" Value="Eye"/>
                                                                <Setter Property="ToolTip" Value="Отображать пароль"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </MD:PackIcon.Style>
                                            </MD:PackIcon>
                                        </Border>

                                        <Border ToolTip="Скопировать пароль" MouseDown="BTN_CopyPassword_MouseDown" Width="20" Height="20" Style="{StaticResource ButtonWhiteHoverStyle}" Margin="10">
                                            <MD:PackIcon Width="20" Height="20" Foreground="LightGray" Kind="ContentCopy" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </MD:TransitioningContent>
        </Grid>
    </Grid>
</Page>
